# domínio apontando (registro A/AAAA) para o IP da VM; ex.: dcchub.com.br
DOMAIN=dcchub.exemplo.com.br
# gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DCCHUB_ADMIN_TOKEN=
# código(s) de acesso da comunidade, separados por vírgula (ex.: um por semestre). Divulgue só nos canais dos
# estudantes. Se vazar, troque: quem entrou com o código antigo precisa digitar o novo. Vazio = site aberto.
DCCHUB_ACCESS_CODES=

# --- acesso por e-mail @ufmg.br (link mágico, sem conta; o e-mail não é guardado) ---
# 1 = liga. Pode conviver com DCCHUB_ACCESS_CODES (a tela mostra o e-mail e, recolhido, o código).
DCCHUB_EMAIL_LOGIN=
# SMTP de um serviço de envio (ex.: Brevo, plano grátis ~300/dia: smtp-relay.brevo.com, porta 587).
# O remetente precisa ser de um domínio verificado no serviço (SPF/DKIM), senão os e-mails caem no spam.
DCCHUB_SMTP_HOST=
DCCHUB_SMTP_PORT=587
DCCHUB_SMTP_USER=
DCCHUB_SMTP_PASSWORD=
DCCHUB_SMTP_FROM=DCCHub <acesso@seu.dominio>
# trocar este valor desconecta todo mundo que entrou por e-mail (cada um pede um link novo)
DCCHUB_EMAIL_EPOCH=1
# teto de links enviados por dia (fique abaixo da cota do serviço; Brevo grátis = 300)
DCCHUB_EMAIL_DAILY_LIMIT=250
