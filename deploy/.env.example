# domínio apontando (registro A/AAAA) para o IP da VM; ex.: dcchub.com.br
DOMAIN=dcchub.exemplo.com.br
# gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DCCHUB_ADMIN_TOKEN=
# código(s) de acesso da comunidade, separados por vírgula (ex.: um por semestre). Divulgue só nos canais dos
# estudantes. Se vazar, troque: quem entrou com o código antigo precisa digitar o novo. Vazio = site aberto.
DCCHUB_ACCESS_CODES=

# --- acesso por e-mail @ufmg.br (código de 6 dígitos, sem conta; o e-mail não é guardado) ---
# 1 = liga. Pode conviver com DCCHUB_ACCESS_CODES (a tela mostra o e-mail e, recolhido, o código).
DCCHUB_EMAIL_LOGIN=
# SMTP para enviar o código. Sem domínio próprio: uma conta Gmail do projeto com senha de app (~500/dia):
#   HOST=smtp.gmail.com, USER=conta@gmail.com, PASSWORD=senha de app (16 letras, sem espaços), FROM=DCCHub <conta@gmail.com>
# Com domínio próprio: um serviço como o Brevo (smtp-relay.brevo.com, ~300/dia grátis), com SPF/DKIM verificados.
# A porta 25 costuma ser bloqueada na nuvem; use 587.
DCCHUB_SMTP_HOST=
DCCHUB_SMTP_PORT=587
DCCHUB_SMTP_USER=
DCCHUB_SMTP_PASSWORD=
DCCHUB_SMTP_FROM=
# trocar este valor desconecta todo mundo que entrou por e-mail (cada um pede um código novo)
DCCHUB_EMAIL_EPOCH=1
# teto de e-mails enviados por dia (fique abaixo da cota do serviço; Gmail ~500, Brevo grátis = 300)
DCCHUB_EMAIL_DAILY_LIMIT=250
